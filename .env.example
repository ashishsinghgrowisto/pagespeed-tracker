# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT signing secret (use a long random string)
JWT_SECRET=your_long_random_jwt_secret_here

# PageSpeed Insights API key
# Get one at: https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=your_pagespeed_insights_api_key

# Master Google Sheet URL (the sheet where all projects are stored)
# The sheet MUST have a tab named "Projects" with headers: ID | Project Name | Sheet URL | Pages | Created At
MASTER_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Google Service Account credentials (base64 encoded JSON)
# 1. Create a Google Cloud project and enable the Google Sheets API
# 2. Create a Service Account and download the JSON key
# 3. Encode it: cat service-account.json | base64
# 4. Share your Master Sheet AND all project sheets with the service account email (Editor access)
GOOGLE_SERVICE_ACCOUNT_B64=base64_encoded_service_account_json_here
